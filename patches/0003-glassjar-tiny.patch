+  /// glassjar: statement and expression kinds that only Objective-C, OpenMP,
+  /// OpenACC, blocks, CUDA, HLSL or SYCL code can produce. A C/C++-only build
+  /// (GLASSJAR_TINY) traps if one is ever constructed, so every dispatch on
+  /// the node kind can treat these cases as unreachable and LTO drops the
+  /// code behind them.
+  static constexpr bool glassjarNeverBuilt(StmtClass C) {
+#ifdef GLASSJAR_TINY
+    switch (C) {
+    case ObjCAtTryStmtClass: case ObjCAtCatchStmtClass:
+    case ObjCAtFinallyStmtClass: case ObjCAtThrowStmtClass:
+    case ObjCAtSynchronizedStmtClass: case ObjCForCollectionStmtClass:
+    case ObjCAutoreleasePoolStmtClass: case ObjCStringLiteralClass:
+    case ObjCBoxedExprClass: case ObjCArrayLiteralClass:
+    case ObjCDictionaryLiteralClass: case ObjCEncodeExprClass:
+    case ObjCMessageExprClass: case ObjCSelectorExprClass:
+    case ObjCProtocolExprClass: case ObjCIvarRefExprClass:
+    case ObjCPropertyRefExprClass: case ObjCIsaExprClass:
+    case ObjCIndirectCopyRestoreExprClass: case ObjCBoolLiteralExprClass:
+    case ObjCSubscriptRefExprClass: case ObjCBridgedCastExprClass:
+    case BlockExprClass: case ArraySectionExprClass: case OMPIteratorExprClass:
+    case OMPArrayShapingExprClass: case OMPCanonicalLoopClass:
+    case OpenACCAsteriskSizeExprClass: case CUDAKernelCallExprClass:
+    case HLSLOutArgExprClass: case SYCLUniqueStableNameExprClass:
+    case SYCLKernelCallStmtClass:
+      return true;
+    default:
+      return (C >= firstOMPExecutableDirectiveConstant &&
+              C <= lastOMPExecutableDirectiveConstant) ||
+             (C >= firstOpenACCConstructStmtConstant &&
+              C <= lastOpenACCConstructStmtConstant);
+    }
+#else
+    return false;
+#endif
+  }
+#define GLASSJAR_NEVER_BUILT_STMT(CLASS)                                       \
+  if (::clang::Stmt::glassjarNeverBuilt(::clang::Stmt::CLASS##Class))          \
+    __builtin_unreachable();
